  if(st==='play'&&y<=0&&Math.random()<dt*18)parts.push({x:W/2+px*LW()+(Math.random()-.5)*20,y:gy(),vx:(Math.random()-.5)*60,vy:-Math.random()*60,l:.35,c:'#6b8a93'});
  draw();requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script>

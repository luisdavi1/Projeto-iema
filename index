<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Corrida dos Bits</title>
<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#071419;--cu:#d9893b;--cy:#62e3e8;--mg:#ff4f86;--ink:#e8f6f4;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);background:var(--bg)}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;height:100%;position:relative;overflow:hidden;background:var(--bg);color:var(--ink);font-family:'Chakra Petch',ui-monospace,Menlo,Consolas,monospace;-webkit-user-select:none;user-select:none}
canvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none;display:block}
#hud{position:absolute;top:10px;left:14px;right:14px;display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:20px;pointer-events:none;text-shadow:0 2px 6px #000}
#b::before{content:"";display:inline-block;width:.7em;height:.7em;border-radius:50%;background:var(--cy);margin-right:.4em}
#av{font-size:13px;background:#7bf0a6;color:#06241a;padding:3px 9px;border-radius:5px;text-shadow:none}
.ov{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center}
.ov[hidden],#hud[hidden],#av[hidden]{display:none}
#menu{background:rgba(5,15,19,.6)}
h1{font-size:clamp(38px,11vw,68px);line-height:1;margin:0 0 12px;letter-spacing:-.01em}
#menu p{max-width:34ch;margin:0 0 14px;line-height:1.45;opacity:.9}
ul{list-style:none;padding:0;margin:0 0 20px;line-height:1.9}
li b{display:inline-block;min-width:3.2em;color:var(--cy)}
button{font:700 19px 'Chakra Petch',monospace;background:var(--cu);color:#1a0f05;border:0;border-radius:6px;padding:14px 34px;cursor:pointer}
button:focus-visible{outline:3px solid var(--cy);outline-offset:3px}
#over{background:#1450b4;align-items:flex-start}
.bs{max-width:440px;margin:auto;text-align:left}
.sad{font-size:92px;font-weight:700;line-height:1}
.bs h2{font-size:28px;margin:8px 0 12px}
.bs p{margin:0 0 10px;line-height:1.45;font-size:16px}
.bs .cd{font-size:13px;opacity:.75;margin-bottom:22px}
#re{background:#fff;color:#1450b4}
.hr{display:flex;align-items:center;gap:6px}
#hud button{pointer-events:auto;font-size:15px;padding:6px 12px;background:rgba(5,15,19,.75);color:var(--ink);border:1px solid var(--cu)}
#pause{background:rgba(5,15,19,.78)}
#pause button{margin:6px;min-width:170px}
#qt{background:#10303b;color:var(--ink)}
#toast{position:absolute;top:64px;left:50%;transform:translateX(-50%);background:rgba(5,15,19,.85);border:1px solid var(--cy);padding:8px 14px;border-radius:6px;font-weight:700;pointer-events:none;white-space:nowrap}
#toast[hidden]{display:none}
#ms{font-size:14px;line-height:1.6;margin:0 0 12px}
#ms small{opacity:.7}
#rv{background:#7bf0a6;color:#06241a;margin-right:8px}
#menu{justify-content:flex-start}
#menu>h1{margin-top:auto}
#menu>.row{margin-bottom:auto;display:flex;gap:10px}
#menu input{font:500 16px 'Chakra Petch',monospace;background:#10303b;color:var(--ink);border:1px solid var(--cu);border-radius:6px;padding:10px 12px;margin:0 0 14px;width:min(260px,100%);text-align:center}
#rkb{background:#10303b;color:var(--ink)}
#rk2{background:transparent;color:#fff;border:2px solid #fff;margin-left:8px}
#rank{background:rgba(5,15,19,.94)}
#rl{list-style:none;padding:0;margin:0 0 20px;width:min(360px,100%);text-align:left;line-height:2.1}
#rl li{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid rgba(98,227,232,.2)}
#rl li b{min-width:2em}
#rl li.me{color:#f2c14e}
#rl li span:last-child{opacity:.8;font-size:13px}
#menu{overflow:auto}
#skins{display:flex;gap:8px;margin:0 0 16px;flex-wrap:wrap;justify-content:center}
.sk{font-size:13px;padding:8px 10px;background:#10303b;color:var(--ink);border:2px solid transparent;min-width:76px;line-height:1.3}
.sk[aria-pressed=true]{border-color:var(--cy)}
.sk:disabled{opacity:.55;cursor:not-allowed}
.sk i{display:block;width:22px;height:22px;margin:0 auto 4px;border-radius:4px}
</style>
</head>
<body>
<canvas id="c" aria-label="Jogo Corrida dos Bits"></canvas>
<div id="hud" hidden><span id="m">0 m</span><span id="av" hidden></span><span class="hr"><span id="b">0</span><button id="mu" aria-label="Som">♪</button><button id="ps" aria-label="Pausar">II</button></span></div>
<div class="ov" id="menu">
  <h1>Corrida dos Bits</h1>
  <p>Atravesse o data center, fuja dos erros e colete bits.</p>
  <ul>
    <li><b>← →</b> trocar de trilha</li>
    <li><b>↑</b> pular o firewall</li>
    <li><b>↓</b> deslizar sob o cabo</li>
    <li><b>P</b> pausar</li>
  </ul>
  <div id="skins"></div><ul id="ms"></ul><p id="rec"></p>
  <input id="nm" maxlength="10" placeholder="Seu nome no ranking" aria-label="Seu nome no ranking" autocomplete="off">
  <div class="row"><button id="go">Jogar</button><button id="rkb">Ranking</button></div>
</div>
<div class="ov" id="rank" hidden><h1>Ranking</h1><ol id="rl"></ol><button id="rx">Voltar</button></div>
<div id="toast" hidden></div>
<div class="ov" id="pause" hidden><h1>Pausado</h1><button id="rs">Continuar</button><button id="qt">Voltar ao menu</button></div>
<div class="ov" id="over" hidden>
  <div class="bs">
    <div class="sad">:(</div>
    <h2>Seu sistema travou</h2>
    <p id="why"></p>
    <p id="stat"></p>
    <p class="cd" id="code"></p>
    <button id="rv" hidden>Reviver (100 bits)</button><button id="re">Reiniciar</button><button id="rk2">Ranking</button>
  </div>
</div>
<script>
const $=id=>document.getElementById(id);
const cv=$('c'),ctx=cv.getContext('2d');
let W=0,H=0;
function rs(){const d=Math.min(devicePixelRatio||1,2);W=cv.clientWidth;H=cv.clientHeight;cv.width=W*d;cv.height=H*d;ctx.setTransform(d,0,0,d,0,0)}
addEventListener('resize',rs);rs();
const F=420,FONT='Chakra Petch,monospace';
const hy=()=>H*.3,gy=()=>H*.8,LW=()=>Math.min(W*.3,H*.2);
function proj(x,z){const s=F/(F+Math.max(z,-F*.7));return{s,x:W/2+x*LW()*s,y:hy()+(gy()-hy())*s}}
let st='menu',lane,px,y,vy,slide,speed,dist,bits,obs,far,shield,t=0,sc=0,best=0,mag=0,parts=[],shake=0,total=0,skin=0,tb=0,cd=0,mult=1,combo=0,ct=0,toast=0,zn=-1,ML=[0,0,0],md=[0,0,0],jc=0,bk=0,rvd=false,pops=[],rid=0,RK=[];
const MS=[{t:'Coletar % bits numa corrida',g:40,v:()=>bits},{t:'Correr % m numa corrida',g:500,v:()=>dist},{t:'Pular % vezes numa corrida',g:10,v:()=>jc}];
const goal=i=>Math.round(MS[i].g*(1+ML[i]*.6));
const SK=[{n:'Padrão',c:'#d9893b',s:'#62e3e8',h:'#cfe3e6',p:0},{n:'Hacker',c:'#2f8f4e',s:'#7bf0a6',h:'#9fd9b0',p:150},{n:'Gamer',c:'#a8326a',s:'#ff9bd0',h:'#f5c2dd',p:400},{n:'Quântico',c:'#6b4fd1',s:'#f2c14e',h:'#d9d0ff',p:900},{n:'Ninja',c:'#1a1a22',s:'#ff4f4f',h:'#c9c9d6',p:1500},{n:'Ouro',c:'#c8962b',s:'#fff2b0',h:'#f6e3a1',p:3000}];
const ZS=[['#050f13','#12394a'],['#1a0a24','#4a1d4a'],['#041a14','#0f4a3a']];
try{best=+localStorage.getItem('cb_best')||0;total=+localStorage.getItem('cb_total')||0;skin=Math.min(SK.length-1,+localStorage.getItem('cb_skin')||0);if(total<SK[skin].p)skin=0;const ml=JSON.parse(localStorage.getItem('cb_ml'));if(Array.isArray(ml)&&ml.length===3)ML=ml;const rk=JSON.parse(localStorage.getItem('cb_rk'));if(Array.isArray(rk))RK=rk.slice(0,10)}catch(e){}
function sv(){try{localStorage.setItem('cb_best',best);localStorage.setItem('cb_total',total);localStorage.setItem('cb_skin',skin);localStorage.setItem('cb_ml',JSON.stringify(ML))}catch(e){}}
function reset(){lane=0;px=0;y=0;vy=0;slide=0;speed=520;dist=0;bits=0;obs=[];far=900;shield=false;mag=0;parts=[];shake=0;tb=0;cd=3.2;mult=1;combo=0;ct=0;toast=0;zn=-1;md=[0,0,0];jc=0;bk=0;rvd=false;pops=[];rid=Date.now()}
reset();
function drawSkins(){const el=$('skins');el.innerHTML='';SK.forEach((k,i)=>{const b=document.createElement('button');b.className='sk';b.setAttribute('aria-pressed',i===skin);const un=total>=k.p;b.disabled=!un;b.innerHTML='<i style="background:'+k.c+'"></i>'+k.n+'<br>'+(un?'&nbsp;':k.p+' bits');b.onclick=()=>{skin=i;sv();drawSkins()};el.appendChild(b)})}
function showRec(){$('rec').textContent=(best?'Recorde: '+best+' m · ':'')+'Bits guardados: '+total;drawSkins();$('ms').innerHTML=MS.map((m,i)=>'<li>'+m.t.replace('%',goal(i))+' <small>(nível '+(ML[i]+1)+')</small></li>').join('')}
showRec();
function coins(l,z,n,g=70){for(let i=0;i<n;i++)obs.push({t:'c',l,z:z+i*g,i})}
function row(z){
  const r=Math.random(),L=[-1,0,1].sort(()=>Math.random()-.5);
  if(r<.28){const n=Math.random()<.4?2:1;for(let i=0;i<n;i++)obs.push({t:'rack',l:L[i],z});coins(L[2],z-100,5)}
  else if(r<.48){for(const l of[-1,0,1])obs.push({t:'fw',l,z});coins(L[0],z-110,4,75)}
  else if(r<.66){for(const l of[-1,0,1])obs.push({t:'bar',l,z});coins(L[0],z-250,4)}
  else if(r<.84){obs.push({t:'rack',l:L[0],z},{t:Math.random()<.5?'fw':'pit',l:L[1],z});coins(L[2],z-100,5)}
  else if(r<.93){obs.push({t:'vr',l:0,z,ph:Math.random()*6});coins(L[0],z-100,4)}
  else{coins(L[0],z,7);if(Math.random()<.7)obs.push({t:['sh','mg','tb'][Math.floor(Math.random()*3)],l:L[1],z})}
}
function die(c){
  st='over';
  const m=Math.floor(dist);
  if(m>best)best=m;total+=bits-bk;bk=bits;sv();$('rv').hidden=!(total>=100&&!rvd);const pts=m+bits*2,pos=addRank(pts,m);
  $('why').textContent={pit:'Você caiu no erro 404.',vr:'Um vírus infectou o seu sistema.',rack:'Colisão com um servidor no meio da trilha.',fw:'O firewall bloqueou o seu acesso.',bar:'Um cabo solto derrubou a conexão.'}[c];
  $('stat').textContent=pts+' pts (#'+pos+' no ranking) · '+m+' m · '+bits+' bits · Recorde: '+best+' m';
  $('code').textContent='Código de erro 0x'+(m*7+bits).toString(16).toUpperCase().padStart(6,'0');
  $('hud').hidden=true;$('over').hidden=false;$('re').focus();try{navigator.vibrate&&navigator.vibrate(150)}catch(e){}
}
function start(){unlock();reset();st='play';$('menu').hidden=true;$('over').hidden=true;$('hud').hidden=false;$('av').hidden=true}
$('go').onclick=start;$('re').onclick=start;
function move(d){if(st==='play'){lane=Math.max(-1,Math.min(1,lane+d));snd(220,.07,'sine',.04,140)}}
function jump(){if(st==='play'&&y<=0){vy=900;slide=0;jc++;snd(300,.15,'square',.04,650)}}
function down(){if(st!=='play')return;slide=.6;if(y>0)vy=-1500;snd(180,.3,'sawtooth',.03,60)}
addEventListener('keydown',e=>{
  const k=e.key;if(e.target.tagName==='INPUT')return;if(k==='p'||k==='Escape'){pause(st==='play');return}
  if(k==='ArrowLeft'||k==='a')move(-1);
  else if(k==='ArrowRight'||k==='d')move(1);
  else if(k==='ArrowUp'||k==='w'||k===' '){if(st==='pause')pause(false);else if(st!=='play'&&document.activeElement===document.body)start();else jump();e.preventDefault()}
  else if(k==='ArrowDown'||k==='s'){down();e.preventDefault()}
});
let sx=0,sy=0,sd=false;
cv.addEventListener('pointerdown',e=>{sx=e.clientX;sy=e.clientY;sd=true});
cv.addEventListener('pointermove',e=>{
  if(!sd)return;
  const dx=e.clientX-sx,dy=e.clientY-sy;
  if(Math.max(Math.abs(dx),Math.abs(dy))>26){
    if(Math.abs(dx)>Math.abs(dy))move(dx>0?1:-1);else if(dy<0)jump();else down();
    sd=false;
  }
});
addEventListener('pointerup',()=>sd=false);

function upd(dt){
  if(st==='menu'){sc+=300*dt;return}
  if(st!=='play')return;
  if(cd>0){cd-=dt;sc+=250*dt;return}
  speed=Math.min(1150,speed+dt*7);
  const d=speed*dt*(tb>0?1.6:1);sc+=d;dist+=d/100;far-=d;
  while(far<2600){far+=speed*(.95+Math.random()*.35);row(far)}
  px+=(lane-px)*Math.min(1,dt*14);
  if(y>0||vy>0){vy-=2600*dt;y+=vy*dt;if(y<=0){y=0;vy=0}}
  slide=Math.max(0,slide-dt);mag=Math.max(0,mag-dt);tb=Math.max(0,tb-dt);
  if(ct>0){ct-=dt;if(ct<=0){combo=0;mult=1}}
  if(toast>0){toast-=dt;if(toast<=0)$('toast').hidden=true}
  const zz=Math.floor(dist/400);
  if(zz!==zn){if(zn>=0){bits+=25;$('toast').textContent='Zona '+(zz+1)+': '+ZN[zz%3]+' (+25 bits)';$('toast').hidden=false;toast=2.5;snd(500,.3,'triangle',.06,1000)}zn=zz}
  for(const o of obs){o.z-=d;if(o.t==='vr')o.l=Math.sin(t*2.2+o.ph)*1.05}
  for(let i=obs.length-1;i>=0;i--){
    const o=obs[i];
    if(o.z<-70){obs.splice(i,1);continue}
    if(!o.nm&&o.z<-30&&'rack,vr,fw,bar,pit'.includes(o.t)&&Math.abs(px-o.l)>=.55&&Math.abs(px-o.l)<1){o.nm=1;bits+=2;pop('QUASE! +2','#62e3e8')}
    if(mag>0&&o.t==='c'&&o.z<800)o.l+=(px-o.l)*Math.min(1,dt*5);
    if(Math.abs(px-o.l)>.55)continue;
    if(o.t==='c'){if(Math.abs(o.z)<45){ct=1.6;combo++;const m0=mult;mult=1+Math.min(4,Math.floor(combo/8));if(mult>m0)pop('COMBO x'+mult,'#f2c14e');bits+=mult*(tb>0?2:1);burst(W/2+px*LW(),gy()-LW()*.5-y,'#62e3e8',5);snd(900+(bits%8)*70,.07,'triangle');obs.splice(i,1)}continue}
    if(o.t==='sh'){if(Math.abs(o.z)<45){shield=true;snd(500,.25,'triangle',.07,1000);obs.splice(i,1)}continue}
    if(o.t==='mg'){if(Math.abs(o.z)<45){mag=8;snd(400,.25,'triangle',.07,1200);obs.splice(i,1)}continue}
    if(o.t==='tb'){if(Math.abs(o.z)<45){tb=5;snd(300,.4,'sawtooth',.06,1100);obs.splice(i,1)}continue}
    if(o.z>-35&&o.z<35){
      const hit=o.t==='rack'||(o.t==='vr'&&y<LW()*.55)||(o.t==='pit'&&y<LW()*.3)||(o.t==='fw'&&y<LW()*.5)||(o.t==='bar'&&slide<=0);
      if(hit&&tb>0){burst(W/2+px*LW(),gy()-LW()*.6,'#f2c14e',10);snd(260,.12,'square',.05);obs.splice(i,1)}else if(hit){
        if(shield){shield=false;shake=.3;snd(150,.25,'sawtooth',.08,60);obs.splice(i,1)}
        else{shake=.5;snd(200,.5,'sawtooth',.09,40);burst(W/2+px*LW(),gy()-LW()*.5-y,'#ff4f86',16);die(o.t);return}
      }
    }
  }
  $('m').textContent=Math.floor(dist)+' m · '+Math.round(speed/10)+' Mbps';
  for(let i=0;i<3;i++)if(!md[i]&&MS[i].v()>=goal(i)){md[i]=1;ML[i]++;bits+=40;pop('MISSÃO! +40','#7bf0a6');snd(600,.4,'triangle',.07,1500)}
  $('b').textContent=bits+(mult>1?' x'+mult:'');
  const pw=[shield?'Antivírus':'',mag>0?'Ímã '+Math.ceil(mag)+'s':'',tb>0?'Turbo '+Math.ceil(tb)+'s':''].filter(Boolean).join(' + ');$('av').hidden=!pw;$('av').textContent=pw;
}

function line(a,b){ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke()}
function scene(){
  let g=ctx.createLinearGradient(0,0,0,hy());const Z=ZS[Math.floor(dist/400)%3];g.addColorStop(0,Z[0]);g.addColorStop(1,Z[1]);
  ctx.fillStyle=g;ctx.fillRect(-W*.1,0,W*1.2,hy()+1);
  ctx.font='12px '+FONT;ctx.textAlign='center';ctx.textBaseline='top';
  for(let i=0;i<16;i++){const rx=(i+.5)*W/16,ry=(t*(40+(i%4)*25)+i*131)%hy();ctx.fillStyle='rgba(98,227,232,'+(.12+(i%3)*.06)+')';ctx.fillText(((i+Math.floor(t*2+ry/20))%2)?'1':'0',rx,ry)}
  const bw=W/10,off=(sc*.03)%bw,bi=Math.floor(sc*.03/bw);
  for(let i=-1;i<12;i++){
    const id=i+bi,h=hy()*(.22+(((id*37)%7+7)%7)/16),bx=i*bw-off;
    ctx.fillStyle='#0a2430';ctx.fillRect(bx,hy()-h,bw*.8,h);
    ctx.fillStyle='rgba(242,193,78,.5)';
    for(let k=0;k<5;k++)if(((id*7+k*3+Math.floor(t))%4)>1)ctx.fillRect(bx+bw*.12+(k%2)*bw*.35,hy()-h+h*.15+Math.floor(k/2)*h*.28,bw*.14,h*.08);
  }
  g=ctx.createLinearGradient(0,hy(),0,H);g.addColorStop(0,'#0f3443');g.addColorStop(1,'#0a2029');
  ctx.fillStyle=g;ctx.fillRect(-W*.1,hy(),W*1.2,H-hy());
  const fz=2800,nz=-300;
  for(let l=-1;l<=1;l++){
    const a=proj(l-.5,fz),b=proj(l+.5,fz),c=proj(l+.5,nz),d=proj(l-.5,nz);
    ctx.fillStyle=l===0?'rgba(98,227,232,.07)':'rgba(98,227,232,.03)';
    ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.lineTo(c.x,c.y);ctx.lineTo(d.x,d.y);ctx.fill();
  }
  ctx.strokeStyle='#d9893b';ctx.lineWidth=2;
  for(const x of[-1.5,-.5,.5,1.5])line(proj(x,fz),proj(x,nz));
  for(let k=0;k<14;k++){
    const z=k*200-(sc%200)-100,a=proj(-1.5,z);
    ctx.strokeStyle='rgba(217,137,59,'+(.45*a.s)+')';ctx.lineWidth=Math.max(1,2*a.s);
    line(a,proj(1.5,z));
  }
  const base=Math.floor(sc/320);
  for(let k=9;k>=0;k--){
    const z=k*320-(sc%320)-100,id=base+k;
    for(const sd of[-1,1]){
      const p=proj(sd*2.6,z),w=LW()*p.s*.9,h=LW()*p.s*(1.7+((id*37+(sd>0?11:0))%5)/4);
      ctx.fillStyle='#10303b';ctx.fillRect(p.x-w/2,p.y-h,w,h);
      ctx.strokeStyle='#d9893b';ctx.lineWidth=Math.max(1,1.5*p.s);ctx.strokeRect(p.x-w/2,p.y-h,w,h);
      for(let i=0;i<4;i++){
        ctx.fillStyle=((id+i+Math.floor(t*3))%3)?'#62e3e8':'#ff4f86';
        ctx.fillRect(p.x-w*.35,p.y-h+h*.12+i*h*.2,w*.12,h*.06);
      }
    }
  }
}
function dobs(o){
  const p=proj(o.l,o.z),s=p.s,u=LW()*s,lw=Math.max(1,2*s);
  if(o.t==='rack'){
    const w=u*.85,h=u*1.7;
    ctx.fillStyle='#17313b';ctx.fillRect(p.x-w/2,p.y-h,w,h);
    ctx.strokeStyle='#d9893b';ctx.lineWidth=lw;ctx.strokeRect(p.x-w/2,p.y-h,w,h);
    for(let i=0;i<6;i++){
      const yy=p.y-h+h*.08+i*h*.15;
      ctx.fillStyle='#0b1a20';ctx.fillRect(p.x-w*.42,yy,w*.84,h*.11);
      ctx.fillStyle=((i+Math.floor(t*4))%3)?'#62e3e8':'#ff4f86';
      ctx.fillRect(p.x+w*.26,yy+h*.03,w*.09,h*.05);
    }
  }else if(o.t==='fw'){
    const w=u*.98,h=u*.5;
    ctx.fillStyle='#c2412d';ctx.fillRect(p.x-w/2,p.y-h,w,h);
